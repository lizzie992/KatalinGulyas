@page "/Projects"
<PageTitle>Projects</PageTitle>

<h1>Things I have built:</h1>

<table>
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Tech stack</th>
    </tr>
    <tr>
        <td><a href="/Baxi" class="project-name-link">@_baxiTitle</a></td>
        <td>@_baxiDescription</td>
        <td>@_baxiTechStack</td>
    </tr>
    <tr>
        <td><a href="/Rocketvideo" class="project-name-link">@_rocketvideoTitle</a></td>
        <td>@_rocketvideoDescription</td>
        <td>@_rocketvideoTechStack</td>
    </tr>
    <tr>
        <td><a href="/Personal" class="project-name-link">@_privatePageTitle</a></td>
        <td>@_privatePageDescription</td>
        <td>@_privatePageTechStack</td>
    </tr>
</table>



@code {

    private string _baxiTitle = "Baxi";
    private string _baxiDescription = "A protected ride-sharing platform built solo for colleagues to safely find drivers or passengers for their commute. Features route matching, an interactive map, in-app chat, and admin moderation tools.";
    private string _baxiTechStack = "C# / .NET, Blazor, ASP.NET Core, Entity Framework Core, MySQL, Docker, Google Maps API";

    private string _rocketvideoTitle = "RocketVideo";
    private string _rocketvideoDescription = "A video and course-hosting platform built with a fixed development team, supporting courses organized into modules and lectures. Includes scheduled content release.";
    private string _rocketvideoTechStack = "C# / .NET, Blazor, Entity Framework Core";

    private string _privatePageTitle = "Portfolio";
    private string _privatePageDescription = "My personal portfolio site, designed and built from scratch. Statically hosted with a fully automated deployment pipeline.";
    private string _privatePageTechStack = "C# / .NET 10, Blazor WebAssembly, HTML5 / CSS3, Azure Static Web Apps, GitHub Actions, Git";

}

