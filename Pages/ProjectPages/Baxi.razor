@page "/Baxi"
<PageTitle>Baxi</PageTitle>

<h1>@_title</h1>

<div class="div-title">@_contribution</div>

<div class="div-title">
    <a href="https://github.com/lizzie992/Baxi" target="_blank">
        <p>Github</p>
    </a>
</div>

<div class="div-title">@_smallTitle</div>

<div class="div-text">@_shortDescription</div>

<div class="div-title">@_featuresTitle</div>

<div class="div-text">@_features</div>

<div class="div-title">
    <img src="images/adcreation.png" alt="Ad Creation" class="pic-projects"/>
</div>
<div class="div-title">
    <img src="images/adslist.png" alt="Ad List" class="pic-projects"/>
</div>
<div class="div-title">
    <img src="images/usermanagement.png" alt="User Management" class="pic-projects"/>
</div>

<div class="div-title">@_techStackTitle</div>

<div class="div-text">@_techStackDescription</div>

<div class="div-title">@_howItWorksTitle</div>

<div class="div-text">@_howItWorks</div>

<div class="div-title">
    <p>
        Demo videos
    </p>
    <div class="video-block">
        <p class="video-label">English</p>
        <div class="video-wrapper">
            <iframe src="https://www.youtube-nocookie.com/embed/1QEUl1pSrtI"
                    title="Baxi demo video (English)"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen>
            </iframe>
        </div>
    </div>
    <div class="video-block">
        <p class="video-label">German</p>
        <div class="video-wrapper">
            <iframe src="https://www.youtube.com/embed/5GR0aDssb9s"
                    title="Baxi demo video (German)"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen>
            </iframe>
        </div>
    </div>
    <div class="video-block">
        <p class="video-label">Hungarian</p>
        <div class="video-wrapper">
            <iframe src="https://www.youtube.com/embed/4YBxYwHhnbE"
                    title="Baxi demo video (Hungarian)"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen>
            </iframe>
        </div>
    </div>
</div>

@code {

    private string _title = "Baxi";

    private string _contribution = "Baxi was created as a solo project, all features and code was create by me.\n"
                                   + "No AI agent was involved in the build and design of this app";

    private string _smallTitle = "An efficient and modern solution for the everyday challenges of getting to Baierbrunn";

    private string _shortDescription = "Baxi was created to fill the need for reliable transport options to get to/from the office whenever public transport is not available.\n It offers a protected ride-sharing platform where colleagues at a company can safely find potential drivers or passengers.";

    private string _featuresTitle = "As a user-friendly application, Baxi offers the following festures:";

    private string _features = "The possibility to post ads — both as passenger or driver — in order to find or offer a ride from / to work\n"
                               + "Browsing through all ads with an interactive map visualizing all options\n"
                               + "Matching ad recommendations based on efficient calculation of overlapping routes and distances\n"
                               + "A built-in chat for quick and safe contact with other users regarding a posted ad\n"
                               + "An efficient email notification system\n"
                               + "Safety features, including password-protected registration and reporting options where admins can take action (deleting ads, warning or banning users)\n"
                               + "Language selection to support all cultures\n";

    private string _techStackTitle = "Tech Stack";

    private string _techStackDescription = "C# / .NET — core application language and runtime\n"
                                           + "ASP.NET Core — web application framework\n"
                                           + "Blazor — component-based UI, written entirely in C# rather than JavaScript\n"
                                           + "Entity Framework Core — ORM and data access layer\n"
                                           + "MySQL — relational database\n"
                                           + "HTML5 & CSS3\n"
                                           + "JavaScript — used selectively for browser interop (see below)\n"
                                           + "Google Maps API — geolocation and route visualization\n"
                                           + "Published in a docker container on a linux server";

    private string _howItWorksTitle = "How It Works";
    
    private string _howItWorks = "Matching engine. When a user posts an ad, Baxi compares its route against all open ads in the opposite role (driver ↔ passenger) and scores them by geographic overlap and distance, rather than requiring an exact start/end match. This surfaces rides that are a good-enough fit — for example a driver whose route passes near a passenger's stop — instead of only exact matches, which would make the platform far less useful given how few colleagues share an identical commute.\n"
                                 + "Real-time chat. Built with event handlers rather than polling, so messages appear immediately without the client repeatedly asking the server for updates. This keeps the app responsive without adding unnecessary server load.\n"
                                 + "Geolocation. Integrated with the Google Maps JavaScript API for interactive map browsing and distance/route calculations. Since Blazor components are C#-first, the Maps JS SDK is loaded and called via JavaScript interop — one of the few places in the app where JavaScript is used directly.\n"
                                 + "Safety and moderation. Registration is password-protected, and a reporting system lets admins take action on flagged ads or users (removal, warnings, bans) without needing direct database access.\n"
                                 + "Localization. UI strings are built to support multiple languages from the start, reflecting the multicultural makeup of the intended user base.\n";


}